<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The site the app runs (a launch argument can override it for testing: -GTBaseURL http://localhost:5005) -->
	<key>GTBaseURL</key>
	<string>https://game-temple.org</string>
	<!-- Two screens: the phone, and a connected TV (the scene delegates are picked in AppDelegate.swift) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Testing against the server on this Mac -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
